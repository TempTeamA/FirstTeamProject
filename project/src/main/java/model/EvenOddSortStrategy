package model.implementations;

import shared.abstractions.UserCollection;
import shared.implementations.CustomUserCollection;
import shared.implementations.User;

import java.util.Comparator;
import java.util.List;
// Доп задание №1
public class EvenOddSortStrategy {
    public UserCollection sortEvenAgesOnly(UserCollection collection){
        List<User> list = collection.getUsersList();

        List<User> evenUser = list.stream()
                                .filter(u -> u.getAge() % 2 == 0)
                                .sorted(Comparator.comparingInt(User::getAge))
                                .toList();

        int evenIndex = 0;
        for (int i = 0; i < list.size(); i++){
            if (list.get(i).getAge() % 2 == 0){
                list.set(i, evenUser.get(evenIndex++));
            }
        }
        return new CustomUserCollection(list);
    }
}
