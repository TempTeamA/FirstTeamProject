package model.implementations;

import shared.abstractions.UserCollection;
import shared.implementations.CustomUserCollection;
import shared.implementations.User;

import java.util.List;
import java.util.Random;
import java.util.stream.Stream;

public class UserGenerator {
    public UserCollection generateRandomUser(int count){
        Random random = new Random();
        List<User> generated = Stream.generate(() -> new User.UserBuilder().
                setName("User_" + random.nextInt(10000)).
                setPassword("pass" + random.nextInt(100)).
                setEmail("user" + random.nextInt(10) + "@mail.com").
                setAge(random.nextInt(80) + 14).build()).limit(count).toList();

        return new CustomUserCollection(generated);
    }
}
