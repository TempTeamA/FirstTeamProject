            <Label fx:id="ageErrorLabel" layoutX="321.0" layoutY="38.0" />
            <Label fx:id="mailErrorLabel" layoutX="321.0" layoutY="74.0" />
            <Label fx:id="passwordErrorLabel" layoutX="321.0" layoutY="112.0" />
         </children>
      </Group>
   </children>
</AnchorPane>
