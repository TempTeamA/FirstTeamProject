<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fxforsomestufftest.controllers.HandInputInfoMenu">
   <children>
      <Group layoutX="37.0" layoutY="60.0">
         <children>
            <Label layoutY="5.0" text="Имя пользователя" />
