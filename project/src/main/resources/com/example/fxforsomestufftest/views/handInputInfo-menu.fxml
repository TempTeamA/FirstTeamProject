            <TextField fx:id="ageText" layoutX="146.0" layoutY="37.0" prefHeight="26.0" prefWidth="176.0" />
            <Label layoutY="79.0" text="Почта" />
            <TextField fx:id="mailText" layoutX="146.0" layoutY="74.0" prefHeight="26.0" prefWidth="176.0" />
            <Label layoutX="1.0" layoutY="117.0" text="Пароль" />
            <TextField fx:id="passwordText" layoutX="146.0" layoutY="112.0" prefHeight="26.0" prefWidth="176.0" />
         </children>
      </Group>
      <Group layoutX="73.0" layoutY="286.0">
         <children>
            <Button layoutX="334.0" mnemonicParsing="false" onAction="#getInfoButton" text="Записать" />
            <Button mnemonicParsing="false" onAction="#backWriteButtonClick" text="Назад" />
         </children>
      </Group>
      <Group layoutX="72.0" layoutY="64.0">
         <children>
            <Label fx:id="setTextInfo" layoutY="172.0" />
